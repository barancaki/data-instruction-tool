class AddressFinder:
    """
    Eksik adresleri şirket websitesinden çeker.
    """
    ADDRESS_SELECTORS = [
        '[class*="address"]',
        '[class*="adres"]',
        '[itemtype*="PostalAddress"]',
        'address',
        '[class*="location"]',
        '[class*="contact-info"]',
    ]
    
    ADDRESS_PATTERNS = [
        r'\d{5}\s+[A-Za-zığüşöçİĞÜŞÖÇ]+',  # Türk posta kodu
        r'[A-Z]{1,2}\d{1,2}\s*\d[A-Z]{2}',  # UK posta kodu
        r'\d{5}(?:-\d{4})?',  # US posta kodu
    ]
    
    async def find_address(self, company: Company) -> Optional[str]:
        if not company.website:
            return None
        
        # İletişim sayfalarını tara
        for page in ['/contact', '/iletisim', '/about']:
            url = urljoin(company.website, page)
            address = await self._extract_address(url)
            if address:
                return address
        
        return None
    
