#### [NEW] [templates/base.py](file:///c:/Users/serig/OneDrive/Masaüstü/development/data-instruction-tool/HyperScrape/templates/base.py)

Abstract base template:

```python
from abc import ABC, abstractmethod

class BaseTemplate(ABC):
    """
    Tüm scraper template'lerinin base sınıfı.
    Template Method Pattern implementasyonu.
    """
    def __init__(self, config: FairConfig, driver_pool: DriverPool):
        self.config = config
        self.driver_pool = driver_pool
        self.enricher = DataEnricher()
    
    async def scrape_page(self, url: str) -> List[Company]:
        """Template method - scraping akışı."""
        driver = self.driver_pool.get_driver()
        try:
            await self._load_page(driver, url)
            companies = await self._extract_companies(driver)
            enriched = await self._enrich_data(companies)
            return enriched
        finally:
            self.driver_pool.return_driver(driver)
    
    @abstractmethod
    async def _extract_companies(self, driver) -> List[Company]:
        """Her template kendi extraction mantığını implement eder."""
        pass
    
    async def _enrich_data(self, companies: List[Company]) -> List[Company]:
        """Veri zenginleştirme - email, adres, sosyal medya."""
        tasks = [self.enricher.enrich(c) for c in companies]
        return await asyncio.gather(*tasks)
```

