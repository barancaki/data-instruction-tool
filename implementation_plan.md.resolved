#### [NEW] [templates/tuyap.py](file:///c:/Users/serig/OneDrive/Masaüstü/development/data-instruction-tool/HyperScrape/templates/tuyap.py)

Tuyap-style siteler için template (replast, burtarim, pencere, smtech, iplik, maktek):

```python
class TuyapTemplate(BaseTemplate):
    """
    .filter-list__item bazlı siteler için template.
    Desteklenen siteler: replast, burtarim, pencere, smtech, iplik, maktek...
    """
    async def _extract_companies(self, driver) -> List[Company]:
        items = driver.find_elements(By.CSS_SELECTOR, self.config.selectors['company_list'])
        companies = []
        
        for item in items:
            company = Company(
                name=self._safe_extract(item, self.config.selectors['company_name']),
                address=self._safe_extract(item, self.config.selectors['address']),
                phone=self._safe_extract(item, self.config.selectors['phone']),
                website=self._safe_extract_href(item, self.config.selectors['website']),
            )
            
            # Detay butonu varsa ürün gruplarını al
            if self.config.selectors.get('detail_button'):
                company.products = await self._extract_products(item, driver)
            
            companies.append(company)
        
        return companies
```

