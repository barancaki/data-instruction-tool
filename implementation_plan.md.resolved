#### [NEW] [enrichment/email_finder.py](file:///c:/Users/serig/OneDrive/Masaüstü/development/data-instruction-tool/HyperScrape/enrichment/email_finder.py)

Gelişmiş email bulma:

```python
class EnhancedEmailFinder:
    """
    Çoklu kaynaklardan email bulma.
    """
    CONTACT_PAGES = ['/contact', '/iletisim', '/kontakt', '/about', '/hakkimizda', '/impressum']
    
    async def find_emails(self, company: Company) -> List[str]:
        emails = set()
        
        # 1. Ana sayfadan
        if company.website:
            emails.update(await self._scrape_page(company.website))
        
        # 2. İletişim sayfalarından
        for page in self.CONTACT_PAGES:
            if company.website:
                url = urljoin(company.website, page)
                emails.update(await self._scrape_page(url))
        
        # 3. Bing aramasından (fallback)
        if not emails and company.name:
            search_url = await self._bing_search(company.name)
            if search_url:
                emails.update(await self._scrape_page(search_url))
        
        return self._filter_valid_emails(list(emails))
    
    def _filter_valid_emails(self, emails: List[str]) -> List[str]:
        """Geçersiz/spam emailleri filtrele."""
        blacklist = ['noreply', 'no-reply', 'example.com', 'test.com', 'packagingfair.com']
        return [e for e in emails if not any(b in e.lower() for b in blacklist)]
```

