### Streamlit Integration

#### [NEW] [7_HyperScrape.py](file:///c:/Users/serig/OneDrive/Masaüstü/development/data-instruction-tool/pages/7_HyperScrape.py)

Yeni Streamlit sayfası:

```python
import streamlit as st
from HyperScrape import HyperScrapeEngine, load_fair_configs

st.set_page_config(page_title="HyperScrape Engine", layout="wide")

st.title("🚀 HyperScrape Engine v2")
st.markdown("*Yeni nesil fuar scraper - 10x daha hızlı*")

# Sidebar
with st.sidebar:
    st.header("⚙️ Ayarlar")
    
    # Fuar seçimi
    fairs = load_fair_configs()
    selected_fair = st.selectbox("Fuar Seçin", list(fairs.keys()))
    
    # Sayfa sayısı
    page_count = st.number_input("Sayfa Sayısı", min_value=1, max_value=100, value=5)
    
    # Gelişmiş ayarlar
    with st.expander("🔧 Gelişmiş"):
        parallel_workers = st.slider("Paralel İşçi Sayısı", 1, 10, 3)
        enable_email_enrichment = st.checkbox("Email Zenginleştirme", value=True)
        enable_address_enrichment = st.checkbox("Adres Zenginleştirme", value=True)
        use_cache = st.checkbox("Cache Kullan", value=True)

# Ana içerik
if st.button("🚀 Scraping Başlat", type="primary"):
    config = fairs[selected_fair]
    engine = HyperScrapeEngine(config)
    
    # Progress bar
    progress = st.progress(0)
    status = st.empty()
    
    with st.spinner("Veriler çekiliyor..."):
        results = asyncio.run(engine.scrape_all(
            page_count=page_count,
            progress_callback=lambda p, s: (progress.progress(p), status.text(s))
        ))
    
    st.success(f"✅ {len(results)} firma başarıyla çekildi!")
    
    # Sonuçlar
    df = results.to_dataframe()
    st.dataframe(df, use_container_width=True)
    
    # İndirme seçenekleri
    col1, col2, col3 = st.columns(3)
    with col1:
        st.download_button("📥 Excel İndir", df.to_excel(), "results.xlsx")
    with col2:
        st.download_button("📥 CSV İndir", df.to_csv(), "results.csv")
    with col3:
        st.download_button("📥 JSON İndir", df.to_json(), "results.json")
    
    # Görselleştirmeler
    st.subheader("📊 İstatistikler")
    # Ülke dağılımı, email bulma başarısı vs.
```

