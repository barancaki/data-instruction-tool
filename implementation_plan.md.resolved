#### [NEW] [core/engine.py](file:///c:/Users/serig/OneDrive/Masaüstü/development/data-instruction-tool/HyperScrape/core/engine.py)

Ana scraping engine:

```python
class HyperScrapeEngine:
    """
    Template Pattern ile jenerik scraping engine.
    """
    def __init__(self, fair_config: FairConfig):
        self.config = fair_config
        self.driver_pool = DriverPool()
        self.cache = ScrapeCache()
        self.logger = get_logger(__name__)
    
    async def scrape_all(self, page_count: int = None) -> ScrapeResult:
        """Ana scraping metodu - paralel işleme ile."""
        template = self._get_template()
        pages = self._get_page_urls(page_count)
        
        # Paralel sayfa scraping
        async with asyncio.TaskGroup() as tg:
            tasks = [tg.create_task(template.scrape_page(url)) for url in pages]
        
        results = [t.result() for t in tasks]
        return self._merge_results(results)
    
    def _get_template(self) -> BaseTemplate:
        """Config'e göre uygun template'i döndürür."""
        templates = {
            'tuyap': TuyapTemplate,
            'deutsche_messe': DeutscheMesseTemplate,
            'modal': ModalTemplate,
            'card': CardTemplate,
        }
        return templates[self.config.template](self.config, self.driver_pool)
```

